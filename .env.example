# apps/api
PORT=4000
MONGODB_URI=mongodb://localhost:27017/gearshare?replicaSet=rs0&directConnection=true
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
WEB_ORIGIN=http://localhost:3000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public origin, e.g. https://gearquest.fi (no trailing slash). Used for canonicals, sitemap and OG URLs.
# Unset in a production build => localhost URLs and noindex, with a build warning.
NEXT_PUBLIC_SITE_URL=
# Optional search engine verification tokens (meta tags are rendered only when set)
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Cloudinary (signed direct uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: signed upload preset with a 5 MB max file size
CLOUDINARY_UPLOAD_PRESET=
