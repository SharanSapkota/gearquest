{
  "name": "@gearquest/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "backfill:city-key": "tsx --env-file-if-exists=../../.env scripts/backfill-city-key.ts",
    "seed:dev": "tsx --env-file-if-exists=../../.env scripts/seed-dev.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@gearquest/shared": "workspace:*",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^9.11.2",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
